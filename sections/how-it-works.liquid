<section id="how"><div class="wrap">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2 style="font-size:32px">{{ section.settings.headline }}</h2>
  <div class="steps">
    {% for block in section.blocks %}
      <div class="step" {{ block.shopify_attributes }}><div class="circ">{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></div>
    {% endfor %}
  </div>
</div></section>
{% schema %}
{ "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ten seconds a morning" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "One glass. That's the whole routine." }
  ],
  "blocks": [ { "type": "step", "name": "Step", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Tear" }, { "type": "text", "id": "body", "label": "Body", "default": "One on-the-go stick pack." } ] } ],
  "presets": [{ "name": "How it works", "blocks": [
    {"type":"step","settings":{"title":"Tear","body":"One on-the-go stick pack. Strawberry lemonade — no chalk, no gagging."}},
    {"type":"step","settings":{"title":"Stir","body":"Into 8–12 oz of water. Dissolves clean, no shaker, no mess."}},
    {"type":"step","settings":{"title":"Sip","body":"Water-soluble, so your body actually absorbs it. Then get on with your day."}}
  ]}]
}
{% endschema %}
