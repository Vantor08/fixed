<section class="band-blush"><div class="wrap">
  <div class="teaser">
    <div class="teaser-img">
      {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title }}" style="width:100%;height:100%;object-fit:cover;border-radius:22px">
      {% else %}<div><span class="msym">image</span><br><br>Product image</div>{% endif %}
    </div>
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.title }}</h2>
      <p class="muted" style="font-size:16.5px;margin-top:4px">{{ section.settings.desc }}</p>
      <ul class="feat-list">
        {% assign feats = section.settings.features | newline_to_br | split: '<br />' %}
        {% for f in feats %}<li>{{ f | strip }}</li>{% endfor %}
      </ul>
      <p class="price">{{ section.settings.price }}</p>
      <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-lg">{{ section.settings.cta }}</a>
    </div>
  </div>
</div></section>
{% schema %}
{ "name": "Featured product teaser",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The daily ritual" },
    { "type": "text", "id": "title", "label": "Title", "default": "Vallore SuperBalance" },
    { "type": "text", "id": "desc", "label": "Description", "default": "Six studied ingredients for hormonal and cortisol support, in one strawberry lemonade glass a day." },
    { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "Supports steadier mood and calmer swings\nClean energy through the afternoon — no jitters\nClinically-dosed SRI-81 Shatavari + Myo-Inositol" },
    { "type": "text", "id": "price", "label": "Price line", "default": "From $17.50 / pouch" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Shop Vallore" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured product teaser" }]
}
{% endschema %}
