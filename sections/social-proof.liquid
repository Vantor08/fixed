<section id="proof" class="band-cream"><div class="wrap">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2 style="font-size:32px">{{ section.settings.headline }}</h2>
  <div class="ugc">
    {% for i in (1..5) %}<div><span class="msym play">play_circle</span>UGC clip</div>{% endfor %}
  </div>
  <div class="revsum">
    <div class="revbig"><div class="n" style="color:var(--berry)"><span class="ph" style="font-size:20px">4.x</span></div><div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class="ct"><span class="phr">N reviews</span></div></div>
    <div class="revbars">
      <div class="rb"><span class="lab">Effectiveness</span><div class="tr"><div class="fi" style="width:90%"></div></div></div>
      <div class="rb"><span class="lab">Taste</span><div class="tr"><div class="fi" style="width:94%"></div></div></div>
      <div class="rb"><span class="lab">Value</span><div class="tr"><div class="fi" style="width:88%"></div></div></div>
      <p class="muted" style="font-size:12.5px;margin-top:10px">Breakdown is illustrative — wire to real review data at launch.</p>
    </div>
  </div>
  <div class="reviews" style="margin-top:20px">
    {% for block in section.blocks %}
      <div class="rev" {{ block.shopify_attributes }}><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><p>"{{ block.settings.quote }}"</p><span class="who"><b>{{ block.settings.author }}</b></span></div>
    {% endfor %}
  </div>
</div></section>
{% schema %}
{ "name": "Social proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Don't just take it from us" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Women who stopped bracing for the bad weeks." }
  ],
  "blocks": [ { "type": "review", "name": "Review", "settings": [ { "type": "textarea", "id": "quote", "label": "Quote", "default": "I finally feel like me the whole month." }, { "type": "text", "id": "author", "label": "Author", "default": "Sample — verified buyer" } ] } ],
  "presets": [{ "name": "Social proof", "blocks": [
    {"type":"review","settings":{"quote":"I finally feel like me the whole month, not just half of it. My husband noticed before I did.","author":"Sample — verified buyer"}},
    {"type":"review","settings":{"quote":"I was taking like eight pills and gave up. This is one drink and I actually keep it up.","author":"Sample — verified buyer"}},
    {"type":"review","settings":{"quote":"The 3 PM crash used to run my afternoons. A few weeks in, it's just… steadier. No jitters.","author":"Sample — verified buyer"}}
  ]}]
}
{% endschema %}
