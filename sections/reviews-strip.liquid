<section class="band-blush"><div class="wrap">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2 style="font-size:34px">{{ section.settings.headline }}</h2>
  <div class="reviews">
    {% for block in section.blocks %}
      <div class="rev" {{ block.shopify_attributes }}><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><p>"{{ block.settings.quote }}"</p><span class="who"><b>{{ block.settings.author }}</b></span></div>
    {% endfor %}
  </div>
  {% if section.settings.cta != blank %}<div style="text-align:center;margin-top:34px"><a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-lg">{{ section.settings.cta }}</a></div>{% endif %}
</div></section>
{% schema %}
{ "name": "Reviews strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In their words" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Women who stopped bracing for the bad weeks." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Start your steadier month" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "I finally feel like me the whole month." },
      { "type": "text", "id": "author", "label": "Author line", "default": "Verified buyer" }
    ]}
  ],
  "presets": [{ "name": "Reviews strip", "blocks": [
    {"type":"review","settings":{"quote":"I finally feel like me the whole month, not just half of it. My husband noticed before I did.","author":"Sample — verified"}},
    {"type":"review","settings":{"quote":"I was taking like eight pills and gave up. This is one drink and I actually keep it up.","author":"Sample — verified"}},
    {"type":"review","settings":{"quote":"The 3 PM crash used to run my afternoons. A few weeks in, it's just… steadier. No jitters.","author":"Sample — verified"}}
  ]}]
}
{% endschema %}
