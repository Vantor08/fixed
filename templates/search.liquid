<section class="band-cream"><div class="wrap narrow" style="padding:60px 0">
  <h1 class="serif" style="font-size:36px">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top:20px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" style="width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:12px">
  </form>
  {% if search.performed %}<p class="muted" style="margin-top:20px">{{ search.results_count }} results</p>{% endif %}
</div></section>
